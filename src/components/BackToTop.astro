---
import { IconArrowLeft } from "@lib/iconSystem"
---

<button
  id="back-to-top"
  class="group relative flex w-fit flex-nowrap rounded border border-black/15 py-1.5 pl-8 pr-3 transition-colors duration-300 ease-in-out hover:text-cyan-700 dark:border-white/25 dark:hover:text-cyan-400"
>
  <span
    class="absolute left-2 top-1/2 size-4 -translate-y-1/2 rotate-90 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-cyan-700 dark:group-hover:stroke-cyan-400"
    ><Fragment set:html={IconArrowLeft} /></span
  >
  <div class="text-sm">Back to top</div>
</button>
