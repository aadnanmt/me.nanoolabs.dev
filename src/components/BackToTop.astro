---
import { IconArrowLeft } from "@lib/iconSystem"
---

<button
  id="back-to-top"
  class="group relative flex w-fit flex-nowrap border border-black/25 py-1.5 pr-3 pl-8 transition-colors duration-300 ease-in-out hover:border-cyan-400/40 dark:border-white/30 dark:hover:border-cyan-400/40"
>
  <span
    class="absolute top-1/2 left-2 size-4 -translate-y-1/2 rotate-90 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-cyan-400 dark:group-hover:stroke-cyan-400"
    ><Fragment set:html={IconArrowLeft} /></span
  >
  <div class="text-sm">Back to top</div>
</button>
