---
import { IconArrowLeft } from "@lib/iconSystem"

type Props = {
  href?: string
}

const { href: initialHref } = Astro.props
const href = initialHref ?? "/"
---

<a
  href={href}
  class="group relative flex w-fit flex-nowrap border border-black/25 py-1.5 pr-3 pl-7 transition-colors duration-300 ease-in-out hover:border-cyan-400/40 dark:border-white/30 dark:hover:border-cyan-400/40"
>
  <span
    class="absolute top-1/2 left-2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-cyan-400 dark:group-hover:stroke-cyan-400"
    ><Fragment set:html={IconArrowLeft} /></span
  >
  <div class="text-sm">
    <slot />
  </div>
</a>
