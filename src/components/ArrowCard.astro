---
import type { CollectionEntry } from "astro:content"
import { getEmoji } from "@lib/emoji"
import { formatDate, readingTime } from "@lib/utils"
import { IconArrowRight } from "@lib/iconSystem"

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">
    | CollectionEntry<"commands">
    | CollectionEntry<"milestones">
}

const { entry } = Astro.props
const mood = entry.collection === "milestones" ? entry.data.mood : undefined
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="group relative flex flex-nowrap border border-black/25 px-4 py-3.5 pr-10 transition-colors duration-300 ease-in-out hover:border-cyan-400/40 dark:border-white/30 dark:hover:border-cyan-400/40"
>
  <div class="flex flex-1 flex-col gap-1 truncate">
    <div class="font-semibold">
      {mood ? `${getEmoji(mood)} ` : ""}{entry.data.title}
    </div>
    <div class="text-sm">
      {entry.data.description}
    </div>
    <div
      class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400"
    >
      <span>{readingTime(entry.body)}</span>
      {
        entry.collection !== "commands" && (
          <>
            <span aria-hidden="true">&middot;</span>
            <time datetime={entry.data.date.toISOString()}>
              {formatDate(entry.data.date)}
            </time>
          </>
        )
      }
    </div>
  </div>
  <span
    class="absolute top-1/2 right-2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-cyan-400 dark:group-hover:stroke-cyan-400"
    ><Fragment set:html={IconArrowRight} /></span
  >
</a>
