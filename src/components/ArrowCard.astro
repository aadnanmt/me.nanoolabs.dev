---
import type { CollectionEntry } from "astro:content"
import { getEmoji } from "@lib/emoji"
import { IconArrowRight } from "@lib/iconSystem"

type Props = {
  entry:
    | CollectionEntry<"blog">
    | CollectionEntry<"projects">
    | CollectionEntry<"commands">
    | CollectionEntry<"milestones">
}

const { entry } = Astro.props
const mood = entry.collection === "milestones" ? entry.data.mood : undefined
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="group relative flex flex-nowrap rounded-lg border border-black/15 px-4 py-3 pr-10 transition-colors duration-300 ease-in-out hover:text-cyan-700 dark:border-white/25 dark:hover:text-cyan-400"
>
  <div class="flex flex-1 flex-col truncate">
    <div class="font-semibold">
      {mood ? `${getEmoji(mood)} ` : ""}{entry.data.title}
    </div>
    <div class="text-sm">
      {entry.data.description}
    </div>
  </div>
  <span
    class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2 transition-colors duration-300 ease-in-out group-hover:stroke-cyan-700 dark:group-hover:stroke-cyan-400"
    ><Fragment set:html={IconArrowRight} /></span
  >
</a>
