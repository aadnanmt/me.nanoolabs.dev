---
import Link from "@components/Link.astro"
import { SITE, SOCIALS } from "@consts"
import { IconGithub } from "@lib/iconSystem"
---

<header
  class="fixed left-0 right-0 top-5 z-50 flex items-center justify-center"
>
  <div
    class="mx-4 flex h-14 w-full max-w-screen-md items-center justify-between gap-2 rounded-lg border border-black/10 bg-canvas-soft-light/70 px-4 saturate-200 backdrop-blur-md transition-all duration-300 ease-in-out dark:border-cyan-400/20 dark:bg-canvas-soft-dark/50 sm:mx-0 sm:gap-5 sm:px-8"
  >
    <Link href={"/"} underline={false}>
      <div
        class="flex shrink-0 items-center font-mono font-bold tracking-wider text-black dark:text-white"
      >
        {SITE.NAME}
      </div>
    </Link>

    <nav class="flex items-center gap-1.5 text-sm font-medium sm:gap-1">
      <Link href="/blog"> blog </Link>
      <span class="hidden opacity-20 sm:block">
        {`/`}
      </span>
      <Link href="/now"> now </Link>
      <span class="hidden opacity-20 sm:block">
        {`/`}
      </span>
      <Link href="/projects"> projects </Link>
      <span class="hidden opacity-20 sm:block">
        {`/`}
      </span>
      <Link href="/explore"> explore </Link>

      <div class="ml-1 mr-1 h-4 w-px bg-black/10 dark:bg-white/20 sm:ml-2">
      </div>
      <Link
        href={SOCIALS.find((s) => s.NAME === "github")?.HREF || SITE.REPO}
        external
        aria-label="GitHub"
        underline={false}
        class="flex shrink-0 items-center"
      >
        <div class="size-5 fill-zinc-500">
          <Fragment set:html={IconGithub} />
        </div>
      </Link>
    </nav>
  </div>
</header>
