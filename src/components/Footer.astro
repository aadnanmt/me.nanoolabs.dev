---
import Container from "@components/Container.astro"
import { SITE } from "@consts"
import BackToTop from "@components/BackToTop.astro"
import Link from "@components/Link.astro"
const currentYear = new Date().getFullYear()
const gitHash = import.meta.env.GIT_HASH
const repoUrl = SITE.REPO
---

<footer>
  <Container>
    <div class="relative">
      <div class="absolute -top-20 right-0">
        <BackToTop />
      </div>
    </div>

    <div
      class="mb-8 flex justify-center opacity-20 transition-opacity select-none hover:opacity-50"
    >
      <pre
        class="font-mono text-xs leading-none">
█▄ █ ▄▀█ █▄ █ █▀█ █▀█
█ ▀█ █▀█ █ ▀█ █▄█ █▄█
      </pre>
    </div>

    <div
      class="flex flex-col items-center justify-between gap-y-4 text-sm md:flex-row"
    >
      <div class="flex flex-wrap items-center gap-2">
        &copy; {currentYear}
        {SITE.NAME}
        <span class="opacity-50">|</span>
        <span class="flex items-center gap-1 font-mono opacity-50">
          {
            gitHash && gitHash !== "unknown" && (
              <Link
                href={`${repoUrl}/commit/${gitHash}`}
                external
                underline={false}
                class="transition-colors hover:text-cyan-400"
              >
                {gitHash}
              </Link>
            )
          }
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <Link
          href="/credits"
          underline={false}
          class="transition-colors hover:text-cyan-400"
        >
          Credits
        </Link>

        <span class="opacity-50">|</span>
        <Link
          href="/rss.xml"
          underline={false}
          class="transition-colors hover:text-cyan-400"
        >
          RSS
        </Link>

        <span class="opacity-50">|</span>
        <Link
          href="https://creativecommons.org/licenses/by/4.0/"
          external
          underline={false}
          class="transition-colors hover:text-cyan-400"
        >
          CC BY 4.0
        </Link>
      </div>
    </div>
  </Container>
</footer>
