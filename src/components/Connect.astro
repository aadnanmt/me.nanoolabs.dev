---
import { SITE, SOCIALS } from "@consts"
import Link from "@components/Link.astro"
import { IconSend, IconEmail, getIcon } from "@lib/iconSystem"
---

<section class="animate space-y-4">
  <h5 class="flex items-center gap-2 font-semibold text-black dark:text-white">
    <span class="size-5 fill-zinc-500 text-zinc-500"
      ><Fragment set:html={IconSend} /></span
    >
    Let's Connect
  </h5>
  <article>
    <p>
      Have a wild idea, want to collaborate, or just fancy a technical
      discussion? Reach out anytime. Let's build something that actually scales.
    </p>
  </article>
  <ul class="flex flex-wrap gap-2">
    <li class="line-clamp-1 flex items-center gap-x-2">
      <span class="size-4 fill-zinc-500 text-zinc-500">
        <Fragment set:html={IconEmail} />
      </span>
      <Link
        href={`mailto:${SITE.EMAIL}`}
        aria-label={`Email ${SITE.NAME} at ${SITE.EMAIL}`}
      >
        Email
      </Link>
      {"/"}
    </li>
    {
      SOCIALS.filter((SOCIAL) => SOCIAL.ACTIVE).map((SOCIAL) => (
        <li class="flex items-center gap-x-2 text-nowrap">
          <span class="size-4 fill-zinc-500 text-zinc-500">
            <Fragment set:html={getIcon(SOCIAL.NAME)} />
          </span>
          <Link
            href={SOCIAL.HREF}
            external
            aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
          >
            {SOCIAL.NAME}
          </Link>
          {"/"}
        </li>
      ))
    }
  </ul>
</section>
