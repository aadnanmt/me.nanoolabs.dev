---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import BackToPrev from "@components/BackToPrev.astro"
import Link from "@components/Link.astro"
import TimeStatus from "@components/TimeStatus.astro"
import { SITE, SOCIALS, CONTACT } from "@consts"
import { getIcon, IconEmail } from "@lib/iconSystem"
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <div
        class="animate flex items-center gap-2 font-semibold text-black dark:text-white"
      >
        <div class="size-5 fill-current">
          <Fragment set:html={IconEmail} />
        </div>
        Connect
      </div>
      <p class="animate">Best ways to reach me, depending on what you need.</p>

      <div class="animate">
        <TimeStatus />
      </div>

      <div class="space-y-12">
        <section class="animate space-y-4">
          <h4 class="font-semibold text-black dark:text-white">
            Professional Inquiries
          </h4>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            For collaboration, project proposals, or deep technical discussions,
            email is the most reliable way to reach me.
          </p>
          <div class="flex items-center gap-2">
            <div class="size-4 fill-zinc-500 text-zinc-500">
              <Fragment set:html={IconEmail} />
            </div>
            <Link href={`mailto:${SITE.EMAIL}`} external>
              {SITE.EMAIL}
            </Link>
          </div>
        </section>

        <section class="animate space-y-6">
          <h4 class="font-semibold text-black dark:text-white">
            Social Presence
          </h4>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            Follow my journey, see my experiments, or just reach out for a quick
            chat.
          </p>

          <ul class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="group flex flex-col gap-1 border-l-2 border-zinc-200 pl-4 dark:border-zinc-800">
                  <div class="flex items-center gap-2">
                    <div class="size-4 fill-zinc-500 text-zinc-500">
                      <Fragment set:html={getIcon(SOCIAL.NAME)} />
                    </div>
                    <Link
                      href={SOCIAL.HREF}
                      external
                      class="font-medium text-black capitalize dark:text-white"
                    >
                      {SOCIAL.NAME}
                    </Link>
                    {SOCIAL.ACTIVE && (
                      <span class="rounded-full bg-cyan-400/10 px-2 py-0.5 text-[10px] tracking-wider text-cyan-700 uppercase dark:text-cyan-400">
                        active
                      </span>
                    )}
                  </div>
                  <span class="text-xs text-zinc-500">
                    {SOCIAL.DESCRIPTION}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-4">
          <h4 class="font-semibold text-black dark:text-white">
            Support my work
          </h4>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            If you find my digital garden or open-source projects useful,
            consider supporting my research and maintenance.
          </p>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div
              class="space-y-2 rounded-lg border border-black/10 p-4 dark:border-white/10"
            >
              <span
                class="text-xs font-semibold tracking-wider text-zinc-500 uppercase"
                >Fiat / Traditional</span
              >
              <div class="flex items-center gap-2">
                <div class="size-4 fill-zinc-500 text-zinc-500">
                  <Fragment set:html={getIcon("ko-fi")} />
                </div>
                <Link
                  href="https://ko-fi.com/aadnanmt"
                  external
                  class="font-medium text-black dark:text-white"
                >
                  Ko-fi
                </Link>
              </div>
              <p class="text-xs text-zinc-500">
                Fast, 0% platform fee, supports PayPal & Cards.
              </p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </Container>
</PageLayout>
