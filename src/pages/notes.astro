---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import BackToPrev from "@components/BackToPrev.astro"
import { NOTES } from "@consts"

const notes = (await getCollection("notes"))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const grouped = notes.reduce(
  (acc, note) => {
    const key = note.data.date.toISOString().slice(0, 10)
    ;(acc[key] ||= []).push(note)
    return acc
  },
  {} as Record<string, typeof notes>
)
---

<PageLayout title={NOTES.TITLE} description={NOTES.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev> Back to home </BackToPrev>
      <div
        class="flex items-center gap-2 font-semibold text-black dark:text-white"
      >
        Notes
      </div>
      {NOTES.INTRO!.map((paragraph) => <p>{paragraph}</p>)}
      <div>
        {
          Object.entries(grouped).map(([date, dayNotes]) => (
            <section class="border-b border-black/5 py-6 last:border-0 dark:border-white/5">
              <time
                class="font-mono text-sm font-semibold whitespace-nowrap text-zinc-600 dark:text-zinc-400"
                datetime={date}
              >
                {date}
              </time>
              <div class="mt-3 space-y-4">
                {dayNotes.map(async (note) => {
                  const { Content } = await note.render()
                  return (
                    <article class="flex flex-col gap-1 sm:flex-row sm:gap-3">
                      <div class="flex items-baseline gap-2 sm:w-16 sm:shrink-0 sm:pt-1">
                        <span class="font-mono text-xs text-zinc-500">
                          {String(dayNotes.indexOf(note) + 1).padStart(2, "0")}
                        </span>
                        <span aria-hidden="true">{note.data.mood ?? ""}</span>
                      </div>
                      <div class="prose prose-neutral dark:prose-invert max-w-none min-w-0">
                        <Content />
                      </div>
                    </article>
                  )
                })}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
