---
export const prerender = true
import { getCollection, type CollectionEntry } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import FormattedDate from "@components/FormattedDate.astro"
import { readingTime, gitDate } from "@lib/utils"
import { getEmoji } from "@lib/emoji"
import BackToPrev from "@components/BackToPrev.astro"
import { SITE } from "@consts"
import Link from "@components/Link.astro"

type Entry =
  | CollectionEntry<"blog">
  | CollectionEntry<"projects">
  | CollectionEntry<"commands">
// Milestones: disabled from digital garden (see TODO.md)
// | CollectionEntry<"milestones">

export async function getStaticPaths() {
  // Milestones: disabled from difital garden (see TODO.md)
  const COLLECTIONS = ["blog", "projects", "commands"] as const
  const paths: {
    params: { collection: string; slug: string | undefined }
    props: { collection: string; entry: Entry }
  }[] = []

  for (const name of COLLECTIONS) {
    const entries = (await getCollection(name)).filter(
      (e) => !("draft" in e.data && e.data.draft)
    )
    for (const entry of entries) {
      paths.push({
        params: { collection: name, slug: entry.slug },
        props: { collection: name, entry },
      })
    }
  }
  return paths
}

const { collection, entry } = Astro.props as {
  collection: string
  entry: {
    id: string
    slug: string
    body: string
    render: Entry["render"]
    data: {
      title: string
      description: string
      date: Date
      category?: string
      demoURL?: string
      repoURL?: string
      mood?: string
      lessonLearn?: string
    }
  }
}

const moodColor: Record<string, string> = {
  Good: "text-green-500",
  Neutral: "text-yellow-500",
  Bad: "text-red-500",
  Tired: "text-blue-500",
  SoHappy: "text-cyan-500",
  SoBad: "text-orange-500",
}

const { Content } = await entry.render()
const lastUpdated = gitDate(`${collection}/${entry.id}`)
const hasDate = collection !== "commands"
const useProse = collection === "commands" || collection === "milestones"
const bigTitle = collection === "commands" || collection === "milestones"
const hasDemo = collection === "projects"
const hasMood = collection === "milestones" // Milestones: disabled (see TODO.md)
const hasLesson = collection === "milestones" // Milestones: disabled (see TODO.md)
const currentMoodColor =
  hasMood && entry.data.mood ? (moodColor[entry.data.mood] ?? "") : ""
const currentMoodEmoji =
  hasMood && entry.data.mood ? getEmoji(entry.data.mood) : ""
const ogImage = `/content/${collection}/${entry.slug}/cover.webp`
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={ogImage}
>
  <Container>
    <div>
      <BackToPrev href={`/${collection}`}>
        {" "}Back to {collection}{" "}
      </BackToPrev>
    </div>
    <div class="my-10 space-y-1">
      <div class="flex items-center gap-1.5">
        {
          hasDate ? (
            <>
              <div class="font-base text-sm">
                <FormattedDate date={entry.data.date} />
              </div>
              {collection !== "milestones" && (
                <>
                  &bull;
                  <div class="font-base text-sm">{readingTime(entry.body)}</div>
                </>
              )}
            </>
          ) : (
            <div class="font-base text-sm">
              Category:{" "}
              <span class="font-semibold text-cyan-500">
                {entry.data.category}
              </span>
            </div>
          )
        }
        {
          lastUpdated && (
            <>
              &bull;
              <div class="font-base text-sm italic opacity-75">
                Last updated: <FormattedDate date={lastUpdated} />
              </div>
            </>
          )
        }
        {
          hasMood && entry.data.mood && (
            <>
              &bull;
              <div class="font-base text-sm">
                Mood:{" "}
                <span class={`${currentMoodColor} font-semibold`}>
                  {entry.data.mood} {currentMoodEmoji}
                </span>
              </div>
            </>
          )
        }
      </div>
      <div
        class={`font-semibold text-black dark:text-white${
          bigTitle ? " text-3xl" : " text-2xl"
        }`}
      >
        {entry.data.title}
      </div>
      {
        hasDemo && (entry.data.demoURL || entry.data.repoURL) && (
          <nav class="flex gap-1">
            {entry.data.demoURL && (
              <Link href={entry.data.demoURL} external>
                demo
              </Link>
            )}
            {entry.data.demoURL && entry.data.repoURL && <span>/</span>}
            {entry.data.repoURL && (
              <Link href={entry.data.repoURL} external>
                repo
              </Link>
            )}
          </nav>
        )
      }
      {
        hasLesson && entry.data.lessonLearn && (
          <p class="mt-2 text-sm italic opacity-70">
            Lesson Learned: &quot;{entry.data.lessonLearn}&quot;
          </p>
        )
      }
    </div>
    <article
      class={`${useProse ? " prose prose-neutral max-w-none dark:prose-invert" : ""}`}
    >
      <Content />
    </article>
    <div class="mt-24 border-t border-black/10 pt-10 dark:border-white/10">
      <p class="text-sm opacity-75">
        This content is licensed under
        <Link
          href="https://creativecommons.org/licenses/by/4.0/"
          external
          class="decoration-cyan-400/50"
        >
          CC BY 4.0
        </Link>
        .<span class="mx-1 opacity-50">|</span>
        <Link
          href={`${SITE.REPO}/edit/main/src/content/${collection}/${entry.id}`}
          external
          class="decoration-cyan-400/50"
        >
          Edit this page
        </Link>
      </p>
    </div>
  </Container>
</PageLayout>
