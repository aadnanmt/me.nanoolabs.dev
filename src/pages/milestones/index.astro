---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"
import ArrowCard from "@components/ArrowCard.astro"
import { IconMilestones } from "@lib/iconSystem"
import { MILESTONES } from "@consts"
import BackToPrev from "@components/BackToPrev.astro"
const milestones = (await getCollection("milestones")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() // Sort by date descending
)
---

<PageLayout title={MILESTONES.TITLE} description={MILESTONES.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <BackToPrev href="/explore"> Back to explore </BackToPrev>
      <div
        class="flex items-center gap-2 font-semibold text-black dark:text-white"
      >
        <div class="size-5 fill-current">
          <Fragment set:html={IconMilestones} />
        </div>
        Milestones
      </div>
      <div class="space-y-4">
        {MILESTONES.INTRO!.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="space-y-4">
        <ul class="flex flex-col gap-3">
          {
            milestones.map((milestone) => (
              <li>
                <ArrowCard entry={milestone} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</PageLayout>
