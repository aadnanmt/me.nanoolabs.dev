---
import { getCollection } from "astro:content"
import Container from "@components/Container.astro"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard.astro"
import Link from "@components/Link.astro"
import { dateRange } from "@lib/utils"
import { SITE, HOME } from "@consts"
import Connect from "@components/Connect.astro"
import NowPlaying from "@components/NowPlaying.astro"
import Mood from "@components/Mood.astro"
import { IconPosts, IconWork, IconProjects } from "@lib/iconSystem"

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE)

const allwork = (await getCollection("work"))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf()
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE)

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="animate flex items-center gap-5">
      <img
        src="https://cdn.nanoolabs.dev/assets/identity/whoami.webp"
        alt="Adnan"
        class="size-32 rounded-lg object-cover"
      />
    </div>
    <div class="mt-8 space-y-16">
      <section>
        <h4 class="font-semibold text-black dark:text-white">
          Adnan (@aadnanmt)
        </h4>
        <article class="space-y-4">
          <p class="animate">
            18 y/o. Still grinding. Fullstack dev, <strong>DevOps leaning</strong>.
          </p>
          <p class="animate">
            I don't just "coding". I like tweaking, modifying, and optimizing
            stuff from the <strong>source code</strong> up to the <strong>hardware level.</strong> Started again in July 2023, then a hard "resync" in early 2025 with
            a new mindset: <strong>Built to be Fast, Simple, Scalable</strong>.
            While everyone vibes on the surface (vibe coders without substance),
            I'm here digging into more fundamental programming, performance,
            edge computing, self-hosting, and building <strong
              >personal AI workflows</strong
            >.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-y-2">
          <h5
            class="flex items-center gap-2 font-semibold text-black dark:text-white"
          >
            <span class="size-5 fill-zinc-500"><Fragment set:html={IconPosts} /></span>
            Latest posts
          </h5>
          <Link href="/blog"> See all posts </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-y-2">
          <h5
            class="flex items-center gap-2 font-semibold text-black dark:text-white"
          >
            <span class="size-5 fill-zinc-500"><Fragment set:html={IconWork} /></span>
            Work Experience
          </h5>
          {/* <Link href="/work"> See all work </Link> */}
        </div>
        <ul class="flex flex-col space-y-4">
          {
            work.map((entry) => (
              <li>
                <div class="text-sm opacity-75">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </div>
                <div class="font-semibold text-black dark:text-white">
                  {entry.data.company}
                </div>
                <div class="text-sm opacity-75">{entry.data.role}</div>
                <article>
                  <entry.Content />
                </article>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-y-2">
          <h5
            class="flex items-center gap-2 font-semibold text-black dark:text-white"
          >
            <span class="size-5 fill-zinc-500"><Fragment set:html={IconProjects} /></span>
            Recent projects
          </h5>
          <Link href="/projects"> See all projects </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <Mood />
        <NowPlaying />
      </section>

      <Connect />
    </div>
  </Container>
</PageLayout>
